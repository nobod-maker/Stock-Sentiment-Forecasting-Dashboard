# ============================================================
# Stock Sentiment & Forecasting Dashboard — Environment Variables
# ============================================================
# Copy this file to .env and fill in your real keys.
# Never commit .env to version control.

# --- News APIs ---
NEWSAPI_KEY=your_newsapi_key_here          # https://newsapi.org  (free tier)
FINNHUB_KEY=your_finnhub_key_here          # https://finnhub.io  (free tier)

# --- LLM (OpenAI-compatible endpoint via llm7.io) ---
LLM_API_KEY=your_llm_api_key_here
LLM_BASE_URL=https://api.llm7.io/v1
LLM_MODEL=default

# --- Optional: Alpha Vantage (news sentiment backup) ---
# ALPHA_VANTAGE_KEY=your_alpha_vantage_key_here

# --- Cache ---
CACHE_DIR=cache                            # relative path for local JSON cache
CACHE_TTL_HOURS=6                          # how long cached data stays valid
